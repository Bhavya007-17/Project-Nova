{
  "manifest_version": 3,
  "name": "Nova",
  "version": "0.6.0",
  "description": "Nova's hands in Chrome: tabs, page clicks and Canvas, driven from Nova on this laptop.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
